{
  "name": "ciftlik-imparatorlugu",
  "version": "1.0.0",
  "private": true,
  "description": "Çizgi film tarzı 3D çiftlik simülasyonu",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs --no-fonts",
    "test": "node scripts/smoke-test.mjs",
    "fuzz": "node scripts/fuzz.mjs",
    "test:backend": "npx -y firebase-tools@13.29.1 emulators:exec --only auth,firestore --project demo-ciftlik \"node scripts/backend-test.mjs\"",
    "bot": "node scripts/bot-sim.mjs",
    "layout": "node scripts/layout-check.mjs out/layout",
    "screenshots": "node scripts/store-screenshots.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "three": "0.147.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "cordova-plugin-purchase": "^13.20.0"
  }
}
